# Supabase configuration (get from your Supabase project dashboard: Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# UPI & QR Code Rotation Threshold (Rotates payment QR/UPI after every N registrations; defaults to 100 if omitted)
# Set to 1 for testing every single registration
VITE_UPI_ROTATION_THRESHOLD=100
