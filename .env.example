# Supabase configuration (get from your Supabase project dashboard: Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# UPI & QR Code Rotation Threshold (Rotates payment QR/UPI after every N registrations; defaults to 100 if omitted)
# Set to 1 for testing every single registration
VITE_UPI_ROTATION_THRESHOLD=100

# ============================================================
# EVENT DAY & ID CARD FEATURE FLAGS
# Set to 'true' to enable, or 'false' to disable/hide
# ============================================================
# 1. Attendee ID Card generation, selfie upload & download pass page
VITE_ENABLE_ALUMNI_ID_CARDS=true

# 2. Organizer Gate Verification scanner, live attendance & spot registration portal
VITE_ENABLE_ADMIN_GATE_PORTAL=true

# 3. Release Official Gate Entry Pass with QR code (defaults to 'false' until released)
VITE_IS_GATE_PASS_RELEASED=false

# ============================================================
# TEST ADMIN CREDENTIALS (Configured in Supabase Auth)
# Email: admin@eck-alumni.org
# Pass:  Admin@12345
# ============================================================
